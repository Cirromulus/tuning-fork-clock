; .pio_version 0 // ??

.program pulsecounter

public entry_point:
    MOV X !null    // Fill with ones
    MOV Y null      // Y is zero to compare
.wrap_target
wait_high_edge:
    WAIT 0 PIN 0
    WAIT 1 PIN 0
    JMP X-- write_value_to_fifo // Only used for decrement
write_value_to_fifo:
    MOV ISR !X  // I don't know a way to directly write X or decrement OSR
    PUSH NOBLOCK
    // IRQ SET 1   // Notify that new value counted
    //             // (not really necessary as FIFO also has status bit, I think)
    JMP X != Y wait_high_edge   // so if not zero -> not wrapped
notify:
    IRQ SET 0   // Notify that counter has wrapped.
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void pulsecounter_program_init(PIO pio, uint sm, uint offset, uint pin) {

    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, false);  // false -> set as input

    pio_sm_config c = pulsecounter_program_get_default_config(offset);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}